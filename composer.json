{
    "name": "reactphp-x/unbash",
    "description": "Async, non-blocking shell command runner for ReactPHP - a promise-based alternative to blocking shell_exec()/exec().",
    "type": "library",
    "keywords": ["reactphp", "async", "shell", "process", "child-process", "non-blocking"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "react/child-process": "^0.6.5",
        "react/event-loop": "^1.5",
        "react/promise": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ReactphpX\\Unbash\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReactphpX\\Unbash\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
