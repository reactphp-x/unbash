{
    "name": "reactphp-x/unbash",
    "description": "Fast, zero-dependency Bash parser for PHP - turns Bash source into a typed, source-positioned AST without executing it. A PHP port of webpro-nl/unbash.",
    "type": "library",
    "keywords": ["bash", "shell", "parser", "ast", "lexer", "tokenizer", "posix"],
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ReactphpX\\Unbash\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ReactphpX\\Unbash\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
